// Prisma schema for Laura Feiteira Estética platform.
//
// This schema is the database foundation for authentication,
// services, professionals, availability, bookings, payments and dashboards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum AppointmentType {
  ONLINE_EVALUATION
  IN_PERSON_EVALUATION
  TREATMENT_SESSION
}

enum EvaluationRequirement {
  OPTIONAL
  REQUIRED
  NOT_REQUIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         UserRole @default(CLIENT)

  // Used later for JWT token versioning.
  tokenVersion Int @default(0)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Professional {
  id String @id @default(cuid())

  name  String
  slug  String  @unique
  email String? @unique
  phone String?

  isActive Boolean @default(true)

  services          ServiceProfessional[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@map("professionals")
}

model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_categories")
}

model Service {
  id         String @id @default(cuid())
  categoryId String

  name        String
  slug        String  @unique
  description String?

  evaluationRequirement EvaluationRequirement @default(OPTIONAL)
  isActive              Boolean               @default(true)

  category      ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options       ServiceOption[]
  bookings      Booking[]
  professionals ServiceProfessional[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@map("services")
}

model ServiceProfessional {
  id String @id @default(cuid())

  serviceId      String
  professionalId String

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents associating the same professional to the same service twice.
  @@unique([serviceId, professionalId])

  @@index([serviceId])
  @@index([professionalId])
  @@map("service_professionals")
}

model ServiceOption {
  id        String @id @default(cuid())
  serviceId String

  name        String
  description String?

  // Price in cents avoids floating point issues.
  // Example: 50€ = 5000.
  priceCents Int?

  // Allows labels such as "Desde 50€" or "Sujeito a avaliação".
  priceLabel String?

  durationMinutes Int?
  isActive        Boolean @default(true)

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([isActive])
  @@map("service_options")
}

model AvailabilitySlot {
  id String @id @default(cuid())

  professionalId String

  startsAt DateTime
  endsAt   DateTime

  appointmentType AppointmentType

  isOpen Boolean @default(true)
  note   String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents the same professional from having two slots starting at the same time.
  // This avoids booking two different services for Laura in the same slot.
  @@unique([professionalId, startsAt])

  @@index([professionalId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([appointmentType])
  @@index([isOpen])
  @@index([professionalId, appointmentType, isOpen])
  @@index([professionalId, startsAt, isOpen])

  @@map("availability_slots")
}

model Booking {
  id String @id @default(cuid())

  userId             String
  serviceId          String
  serviceOptionId    String?
  professionalId     String
  availabilitySlotId String

  appointmentType AppointmentType

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  clientNotes String?

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceOption    ServiceOption?   @relation(fields: [serviceOptionId], references: [id], onDelete: SetNull)
  professional     Professional     @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  availabilitySlot AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents two bookings from using the same availability slot.
  @@unique([availabilitySlotId])

  @@index([userId])
  @@index([serviceId])
  @@index([professionalId])
  @@index([status])
  @@index([appointmentType])
  @@index([paymentStatus])
  @@index([createdAt])

  @@map("bookings")
}